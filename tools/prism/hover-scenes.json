          "title": {
            "fr": "Sélectionner",
            "en": "Select"
          },
          "copy": {
            "fr": "Le collectif prépare une contribution utile. Ses mémoires privées restent dans leur périmètre.",
            "en": "The collective prepares a useful contribution. Its private memories remain within their scope."
          },
          "focus": [
            "source"
          ]
        },
        {
          "from": 4.5,
          "to": 8.5,
          "title": {
            "fr": "Autoriser",
            "en": "Authorise"
          },
          "copy": {
            "fr": "L'objet, sa portée et les conditions de partage sont définis avant le transfert.",
            "en": "The object, scope and sharing conditions are defined before transfer."
          },
          "focus": [
            "export"
          ]
        },
        {
          "from": 8.5,
          "to": 13.5,
          "title": {
            "fr": "Transmettre",
            "en": "Transfer"
          },
          "copy": {
            "fr": "Un objet sélectionné traverse le passage. La connexion n'accorde aucun droit supplémentaire.",
            "en": "A selected object crosses the passage. Connectivity grants no additional authority."
          },
          "focus": [
            "export",
            "import"
          ]
        },
        {
          "from": 13.5,
          "to": 18,
          "title": {
            "fr": "Examiner",
            "en": "Review"
          },
          "copy": {
            "fr": "Le destinataire examine la contribution selon ses propres règles et son besoin.",
            "en": "The recipient reviews the contribution against its own rules and needs."
          },
          "focus": [
            "import"
          ]
        },
        {
          "from": 18,
          "to": 23,
          "title": {
            "fr": "Adopter",
            "en": "Adopt"
          },
          "copy": {
            "fr": "Après sa décision, le destinataire peut utiliser la contribution dans son propre espace.",
            "en": "After its decision, the recipient may use the contribution within its own space."
          },
          "focus": [
            "recipient"
          ]
        },
        {
          "from": 23,
          "to": 29,
          "title": {
            "fr": "Retourner un reçu",
            "en": "Return a receipt"
          },
          "copy": {
            "fr": "Le retour distingue réception, décision et application. Un échange ne fusionne pas les deux collectifs.",
            "en": "The return distinguishes receipt, decision and application. An exchange does not merge the collectives."
          },
          "focus": [
            "import",
            "export"
          ]
        }
      ]
