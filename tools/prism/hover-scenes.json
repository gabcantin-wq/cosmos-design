      "phases": [
        {
          "from": 0,
          "to": 4,
          "title": {
            "fr": "Cadrer",
            "en": "Define"
          },
          "copy": {
            "fr": "Le besoin devient une intention explicite, avec les critères qui permettront de reconnaître un résultat utile.",
            "en": "The need becomes an explicit intent, with criteria for recognising a useful outcome."
          },
          "focus": [
            "need",
            "requirements"
          ]
        },
        {
          "from": 4,
          "to": 8,
          "title": {
            "fr": "Concevoir",
            "en": "Design"
          },
          "copy": {
            "fr": "Les exigences se traduisent en contrats, dépendances et choix de conception.",
            "en": "Requirements become contracts, dependencies and design choices."
          },
          "focus": [
            "requirements",
            "design"
          ]
        },
        {
          "from": 8,
          "to": 15.5,
          "title": {
            "fr": "Construire",
            "en": "Build"
          },
          "copy": {
            "fr": "Les contributions et variantes sont comparées puis assemblées en un candidat traçable.",
            "en": "Contributions and variants are compared and assembled into a traceable candidate."
          },
          "focus": [
            "build",
            "assembly"
          ]
        },
        {
          "from": 15.5,
          "to": 22,
          "title": {
            "fr": "Vérifier",
            "en": "Verify"
          },
          "copy": {
            "fr": "Le candidat passe par les vérifications unitaires et d'intégration. L'assemblage seul ne constitue pas une preuve.",
            "en": "The candidate goes through unit and integration checks. Assembly alone is not evidence."
          },
          "focus": [
            "unit",
            "system"
          ]
        },
        {
          "from": 22,
          "to": 26,
          "title": {
            "fr": "Valider",
            "en": "Validate"
          },
          "copy": {
            "fr": "Le comportement est confronté au besoin et aux critères d'acceptation.",
            "en": "Behaviour is checked against the need and acceptance criteria."
          },
          "focus": [
            "accept"
          ]
        },
        {
          "from": 26,
          "to": 31,
          "title": {
            "fr": "Adopter",
            "en": "Adopt"
          },
          "copy": {
            "fr": "Une version admise peut être appliquée. Ses effets sont ensuite observés dans son environnement.",
            "en": "An admitted version may be applied. Its effects are then observed in its environment."
          },
          "focus": [
            "deploy"
          ]
        },
        {
          "from": 31,
          "to": 39,
          "title": {
            "fr": "Apprendre",
            "en": "Learn"
          },
          "copy": {
            "fr": "L'expérience revient vers le cadrage du prochain cycle. Ce retour conserve la provenance des constats.",
            "en": "Experience informs the next cycle. The feedback retains the provenance of its findings."
          },
          "focus": [
            "need"
          ]
        }
      ]
    },
