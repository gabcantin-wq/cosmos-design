          "title": {
            "fr": "Sélectionner",
            "en": "Select"
          },
          "copy": {
            "fr": "Quelques sources pertinentes sont sélectionnées. Le corpus complet reste à l'extérieur de chaque contexte d'appel.",
            "en": "Relevant sources are selected. The full corpus remains outside each call's context."
          },
          "focus": [
            "selection"
          ]
        },
        {
          "from": 4.5,
          "to": 9,
          "title": {
            "fr": "Borner le contexte",
            "en": "Bound the context"
          },
          "copy": {
            "fr": "L'objectif, les extraits utiles, les contraintes et les acquis forment une entrée maîtrisée.",
            "en": "The objective, relevant excerpts, constraints and prior findings form a bounded input."
          },
          "focus": [
            "parent"
          ]
        },
        {
          "from": 9,
          "to": 15.2,
          "title": {
            "fr": "Répartir",
            "en": "Distribute"
          },
          "copy": {
            "fr": "Le travail peut être décomposé en sous-tâches, chacune avec une portée et une entrée bornées.",
            "en": "Work may be split into subtasks, each with bounded scope and input."
          },
          "focus": [
            "left",
            "right",
            "nested"
          ]
        },
        {
          "from": 15.2,
          "to": 21,
          "title": {
            "fr": "Rapprocher les résultats",
            "en": "Connect findings"
          },
          "copy": {
            "fr": "Les sous-tâches rendent leurs résultats reliés aux sources. Le parent conserve les incertitudes à résoudre.",
            "en": "Subtasks return source-linked findings. The parent retains uncertainties still to resolve."
          },
          "focus": [
            "parent"
          ]
        },
        {
          "from": 21,
          "to": 25,
          "title": {
            "fr": "Conserver les acquis",
            "en": "Retain findings"
          },
          "copy": {
            "fr": "Les résultats intermédiaires et les points de reprise rejoignent la mémoire de travail.",
            "en": "Intermediate findings and recovery points enter working memory."
          },
          "focus": [
            "memory"
          ]
        },
        {
          "from": 25,
          "to": 29.5,
          "title": {
            "fr": "Consolider",
            "en": "Consolidate"
          },
          "copy": {
            "fr": "La synthèse est évaluée à partir des preuves, de la couverture et des incertitudes restantes.",
            "en": "The synthesis is assessed against evidence, coverage and remaining uncertainty."
          },
          "focus": [
            "result"
          ]
        },
        {
          "from": 29.5,
          "to": 35,
          "title": {
            "fr": "Préparer la suite",
            "en": "Prepare the next step"
          },
          "copy": {
            "fr": "Une étape utile réutilise les acquis pour construire son prochain contexte borné. Elle n'emporte pas tout le corpus.",
            "en": "A useful next step reuses findings to build its next bounded context. It does not carry the entire corpus."
          },
          "focus": [
            "memory",
            "selection"
          ]
        }
      ]
